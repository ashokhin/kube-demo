# Copy to .env and fill in real values. Never commit .env to git.
RABBITMQ_URL=amqp://notifications_user:CHANGEME@localhost:5672/
QUEUE_NAME=notifications
LOG_LEVEL=DEBUG
PORT=8080
# Path to the YAML routing rules file. In Kubernetes this is a ConfigMap volume mount.
# Leave unset locally — the service falls back to src/handlers_config.yaml automatically.
# HANDLERS_CONFIG_PATH=/app/config/handlers.yaml

# Copy to .env and fill in real values. Never commit .env to git.
MOCK_MODE=true
LOG_LEVEL=DEBUG
PORT=8081

# In Kubernetes: these point to real Hadoop cluster endpoints
HDFS_URL=hdfs://namenode:8020
HDFS_INPUT_PATH=/data/risk/input
HDFS_OUTPUT_PATH=/data/risk/output

HIVE_HOST=hive-server
HIVE_PORT=10000
HIVE_DATABASE=risk

# Kerberos — paths to Secret and ticket cache volumes
# In Kubernetes these are mounted from Secret (keytab) and emptyDir (cache)
KRB5_KEYTAB_PATH=/keytab/risk-engine.keytab
KRB5_PRINCIPAL=risk-engine@EXAMPLE.COM
KRB5CCNAME=/tmp/krb5/tgt

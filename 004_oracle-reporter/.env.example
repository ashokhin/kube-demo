# Copy to .env and fill in real values. Never commit .env to git.
MOCK_MODE=true
LOG_LEVEL=DEBUG

# Oracle (source data)
ORACLE_DSN=localhost:1521/ORCLPDB1
ORACLE_USER=reporter_user
ORACLE_PASSWORD=CHANGEME

# HDFS (report destination)
HDFS_URL=hdfs://namenode:8020
HDFS_OUTPUT_PATH=/data/reports

# Kerberos
KRB5_KEYTAB_PATH=/keytab/oracle-reporter.keytab
KRB5_PRINCIPAL=oracle-reporter@EXAMPLE.COM
KRB5CCNAME=/tmp/krb5/tgt

# Report settings
REPORT_LOOKBACK_DAYS=30

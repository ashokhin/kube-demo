# Copy to .env and fill in real values. Never commit .env to git.
MOCK_MODE=true
LOG_LEVEL=DEBUG

# Job parameters (injected by risk-ui via Kubernetes Job env vars)
MODEL_VERSION=v1.0
PORTFOLIO_ID=PORTFOLIO_DEFAULT
SCENARIO=base

# Spark mode: submit | operator | yarn
SPARK_MODE=submit

# Hive (input)
HIVE_HOST=hive-server
HIVE_PORT=10000
HIVE_DATABASE=risk

# Oracle (output)
ORACLE_DSN=localhost:1521/ORCLPDB1
ORACLE_USER=risk_user
ORACLE_PASSWORD=CHANGEME

# Kerberos (init container writes TGT to this path)
KRB5_KEYTAB_PATH=/keytab/spark-calculator.keytab
KRB5_PRINCIPAL=spark-calc@EXAMPLE.COM
KRB5CCNAME=/tmp/krb5/tgt

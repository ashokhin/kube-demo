// risk-ui CI pipeline
//
// Follows the same pattern as all services in this repo:
//   Checkout → Lint → Test → Build → Scan → Push → Promote
//
// Spring Boot specifics:
//   - Lint: checkstyle via Maven (no ruff — this is Java)
//   - Test: Maven Surefire (JUnit 5)
//   - Build: Docker multi-stage (Maven build inside Docker, not on agent)
//
// Conventional Commits enforced in commit messages:
//   feat:, fix:, chore:, docs:, refactor:, ci:, perf:

pipeline {
    agent any

    environment {
        SERVICE       = "risk-ui"
        REGISTRY      = "nexus.company.internal"
        PROJECT       = "hadoop-demo"
        IMAGE         = "${REGISTRY}/${PROJECT}/${SERVICE}"
        // Tag format: <branch>-<sha7> — uniquely identifies build source
        TAG           = "${GIT_BRANCH}-${GIT_COMMIT[0..6]}"
        GITOPS_REPO   = "git@bitbucket.company.internal:devops/hadoop-demo-gitops.git"
    }

    stages {

        stage("Checkout") {
            steps {
                checkout scm
            }
        }

        stage("Lint") {
            steps {
                dir("001_risk-ui") {
                    // Checkstyle runs as part of the Maven validate phase.
                    // hadolint checks the Dockerfile for best practices.
                    sh '''
                        docker run --rm \
                            -v "$(pwd)/Dockerfile:/Dockerfile" \
                            hadolint/hadolint:latest \
                            hadolint /Dockerfile
                    '''
                    sh "docker run --rm -v \"\$(pwd):/app\" -w /app maven:3.9-eclipse-temurin-21 mvn validate -q"
                }
            }
        }

        stage("Test") {
            steps {
                dir("001_risk-ui") {
                    sh "docker run --rm -v \"\$(pwd):/app\" -w /app -v \"\$HOME/.m2:/root/.m2\" maven:3.9-eclipse-temurin-21 mvn test -q"
                }
            }
        }

        stage("Build") {
            steps {
                dir("001_risk-ui") {
                    sh "docker build --tag ${IMAGE}:${TAG} ."
                }
            }
        }

        stage("Scan") {
            // Scan the LOCAL image before pushing to registry.
            // This prevents images with HIGH/CRITICAL CVEs from ever reaching Nexus.
            // trivy can scan local Docker images without a registry pull.
            steps {
                sh """
                    docker run --rm \
                        -v /var/run/docker.sock:/var/run/docker.sock \
                        aquasec/trivy:latest image \
                        --exit-code 1 \
                        --severity HIGH,CRITICAL \
                        --ignore-unfixed \
                        ${IMAGE}:${TAG}
                """
            }
        }

        stage("Push") {
            when { branch "main" }
            steps {
                withCredentials([usernamePassword(
                        credentialsId: "nexus-credentials",
                        usernameVariable: "NEXUS_USER",
                        passwordVariable: "NEXUS_PASS")]) {
                    sh "docker login ${REGISTRY} -u ${NEXUS_USER} -p ${NEXUS_PASS}"
                    sh "docker push ${IMAGE}:${TAG}"
                }
            }
        }

        stage("Promote") {
            // Update the image tag in the GitOps repo so ArgoCD picks it up.
            // Jenkins ONLY commits to git — it never runs helm upgrade or kubectl.
            when { branch "main" }
            steps {
                withCredentials([sshUserPrivateKey(
                        credentialsId: "gitops-ssh-key",
                        keyFileVariable: "SSH_KEY")]) {
                    sh """
                        # Verify the Helm chart is syntactically valid before promoting
                        helm lint 006_gitops/helm/${SERVICE}/

                        git clone ${GITOPS_REPO} gitops-repo
                        cd gitops-repo
                        yq e '.image.tag = "${TAG}"' -i helm/${SERVICE}/values-dev.yaml
                        git config user.email "jenkins@company.internal"
                        git config user.name "Jenkins CI"
                        git commit -am "ci(${SERVICE}): promote ${TAG} to dev"
                        git push
                    """
                }
            }
        }
    }

    post {
        always {
            sh "docker rmi ${IMAGE}:${TAG} || true"
            cleanWs()
        }
    }
}

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RISK_RESULTS=risk-results
KAFKA_CONSUMER_GROUP=stream-ingestor-group

# HDFS
HDFS_URL=hdfs://namenode.hadoop.internal:8020
HDFS_OUTPUT_PATH=/data/risk-aggregates

# Hive
HIVE_HOST=hive.hadoop.internal
HIVE_PORT=10000
HIVE_DATABASE=risk

# Kerberos
KRB5CCNAME=/tmp/krb5/tgt
KRB5_KEYTAB_PATH=/keytab/stream-ingestor.keytab
KRB5_PRINCIPAL=stream-ingestor@EXAMPLE.COM

# Spark Streaming trigger interval in seconds
TRIGGER_INTERVAL_SECONDS=30

# Prometheus metrics port
METRICS_PORT=9090

# Local dev: set to true to skip Kafka/HDFS/Hive connections
MOCK_MODE=true

LOG_LEVEL=INFO
